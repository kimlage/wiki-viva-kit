+class WorkerBackend:
+    def __init__(self, path, *, expected_controller_pid, native_session):
+        self._connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self._connection.settimeout(6)
+        self._lock = threading.RLock()
