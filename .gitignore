__pycache__/
*.pyc
.DS_Store

# Local agent/tool state.
tmp/
.playwright-cli/

# Generated local spreadsheet artifacts.
outputs/

# Caminhos de docs deprecados pela metodologia (o auditor proibe versiona-los).
# Conteudo de trabalho local fica fora do git; relocar para memorias/ ou
# docs/referencias/ quando for consolidar.
docs/2026/
docs/memorias/

# Derived transaction ledgers and audit dumps can contain detailed financial data.
data/derived/**
!data/derived/
!data/derived/2026/
!data/derived/2026/regras_classificacao_agent.csv
# Espelho VERSIONADO do ledger de score-events (so metadados, sem segredo) — para
# o karma do cockpit nao zerar em clone limpo/CI. Atualize com `wiki_score.py --mirror`.
!data/derived/wiki/
!data/derived/wiki/score-events-mirror.jsonl

# Raw sources live in a single Drive folder and are fetched on demand into a
# local cache. They contain PII (bank statements/invoices) and must never be
# versioned. Only the Drive registry (filename -> fileId) is tracked.
data/raw/**
!data/raw/
!data/raw/_drive_manifest.json

# Local config with personal ids (Drive folder etc.); .env.example is versioned.
.env
