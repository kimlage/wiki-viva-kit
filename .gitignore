__pycache__/
*.pyc
.DS_Store

# Local agent/tool state.
tmp/
.playwright-cli/

# Generated local spreadsheet artifacts.
outputs/

# Docs paths deprecated by the methodology (the auditor forbids versioning them).
# Local working content stays out of git; relocate to memories/ or
# docs/references/ when consolidating.
docs/2026/
docs/memories/

# Derived ledgers and audit dumps can contain detailed personal/financial data.
data/derived/**
!data/derived/
# VERSIONED mirror of the score-events ledger (metadata only, no secrets) — so the
# cockpit karma does not reset on a clean clone/CI. Update with `wiki_score.py --mirror`.
!data/derived/wiki/
!data/derived/wiki/score-events-mirror.jsonl

# Raw sources live in a single Drive folder and are fetched on demand into a
# local cache. They contain PII (bank statements/invoices) and must never be
# versioned. Only the Drive registry (filename -> fileId) is tracked.
data/raw/**
!data/raw/
!data/raw/_drive_manifest.json

# Local config with personal ids (Drive folder etc.); .env.example is versioned.
.env
