# Copy to .env and fill in. The .env file is NOT versioned.
# Personal Drive folder holding the NON-versioned artifacts the wiki links to
# (general rule: content lives in Drive, manifest+link live in git).
# Publish with: python3 scripts/wiki_drive_publish.py <files>
WIKI_DRIVE_FOLDER_ID=

# Path to the local Google Workspace client helper (per-user, outside the kit).
# Used by scripts/wiki_drive_publish.py. Default: ~/.codex/skills/google-workspace-files/scripts
GOOGLE_WORKSPACE_SCRIPTS=
