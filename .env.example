# Copie para .env e preencha. O .env NAO e versionado.
# Pasta do Drive pessoal onde vivem os artefatos NAO-versionados que a wiki
# referencia (regra geral: conteudo no Drive, manifesto+link no git).
# Publique com: python3 scripts/wiki_drive_publish.py <arquivos>
WIKI_DRIVE_FOLDER_ID=

# Path to the local Google Workspace client helper (per-user, outside the kit).
# Used by scripts/wiki_drive_publish.py. Default: ~/.codex/skills/google-workspace-files/scripts
GOOGLE_WORKSPACE_SCRIPTS=
