{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/wiki-cockpit && npm ci && npm run build",
  "outputDirectory": "apps/wiki-cockpit/dist",
  "installCommand": "cd apps/wiki-cockpit && npm ci",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
