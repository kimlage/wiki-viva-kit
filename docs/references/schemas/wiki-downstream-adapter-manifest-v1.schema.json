{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-viva.local/schemas/wiki-downstream-adapter-manifest-v1.schema.json",
  "title": "Wiki Viva downstream adapter manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files",
    "adapter_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wiki_downstream_adapter_manifest.v1"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^/\\\\][^\\\\\\u0000]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          }
        }
      }
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
