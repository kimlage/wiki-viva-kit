{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "base",
    "head",
    "branch",
    "context_id",
    "packet_digest",
    "changes",
    "query_coverage",
    "review",
    "merge",
    "enforcement_claim"
  ],
  "properties": {
    "schema_version": {
      "const": "wiki.folder-query-preflight/v2"
    },
    "state": {
      "const": "independent_review_required"
    },
    "base": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "head": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "created",
              "modified",
              "deleted"
            ]
          }
        }
      }
    },
    "query_coverage": {
      "const": "reported_not_independently_verified"
    },
    "requirements_handling": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage", "count", "freshness", "legacy_receipt_migration"],
      "properties": {
        "coverage": {"const": "explicit_current_reported_selections_only"},
        "count": {"type": "integer", "minimum": 1},
        "freshness": {"const": "not_assessed"},
        "legacy_receipt_migration": {"const": "not_performed"}
      }
    },
    "capture_handling": {
      "type": "object", "additionalProperties": false,
      "required": ["local_bytes", "external_origin", "external_freshness", "execution"],
      "properties": {
        "local_bytes": {"const": "matched"}, "external_origin": {"const": "not_verified"},
        "external_freshness": {"const": "not_verified"}, "execution": {"const": "not_proven"}
      }
    },
    "repository_handling": {
      "type": "object", "additionalProperties": false,
      "required": ["selection", "remote_authentication", "execution"],
      "properties": {
        "selection": {"const": "matched_request"}, "remote_authentication": {"const": "not_verified"},
        "execution": {"const": "not_proven"}
      }
    },
    "review": {
      "const": "not_performed"
    },
    "merge": {
      "const": "not_performed"
    },
    "enforcement_claim": {
      "const": "none"
    }
  }
}
