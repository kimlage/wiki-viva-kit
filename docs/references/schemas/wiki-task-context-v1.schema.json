{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "content_revision",
    "policy_revision",
    "inputs",
    "declared_read_set",
    "query_fingerprint",
    "bytes_used",
    "capability_evidence",
    "enforcement_claim",
    "task_id",
    "goal",
    "output",
    "integrator",
    "coverage",
    "packet_digest",
    "required_capabilities",
    "max_bytes",
    "selected_text_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": "wiki.task-context/v1"
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "content_revision": {
      "type": "string",
      "minLength": 1
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "section",
          "field",
          "text",
          "byte_length",
          "sha256",
          "revision",
          "document_sha256",
          "origin",
          "reason",
          "producer",
          "use",
          "classification"
        ],
        "properties": {
          "kind": {
            "enum": [
              "mandatory",
              "evidence"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "document_sha256": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": [
              "string",
              "null"
            ]
          },
          "use": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "declared_read_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "section",
          "field",
          "revision"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "query_fingerprint": {
      "type": "null"
    },
    "bytes_used": {
      "type": "integer",
      "minimum": 0
    },
    "capability_evidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verification",
            "capabilities",
            "scope",
            "limitation"
          ],
          "properties": {
            "verification": {
              "const": "verified"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*?\\[\\]]+$"
              }
            },
            "limitation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "enforcement_claim": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "integrator": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "complete",
        "missing"
      ],
      "properties": {
        "mode": {
          "const": "explicit_read_set"
        },
        "complete": {
          "const": false
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "target"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "selected_text_bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
