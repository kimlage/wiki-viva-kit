{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "content_revision",
    "policy_revision",
    "inputs",
    "declared_read_set",
    "query_fingerprint",
    "bytes_used",
    "capability_evidence",
    "enforcement_claim",
    "task_id",
    "goal",
    "output",
    "integrator",
    "coverage",
    "packet_digest",
    "required_capabilities",
    "max_bytes",
    "selected_text_bytes",
    "context"
  ],
  "properties": {
    "schema_version": {
      "const": "wiki.task-context/v1"
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "content_revision": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "policy_revision": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "section",
          "field",
          "text",
          "byte_length",
          "sha256",
          "revision",
          "document_sha256",
          "origin",
          "reason",
          "producer",
          "use",
          "classification"
        ],
        "properties": {
          "kind": {
            "enum": [
              "mandatory",
              "evidence"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "document_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": [
              "string",
              "null"
            ]
          },
          "use": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "type": [
              "string",
              "null"
            ]
          },
          "query_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "declared_read_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "section",
          "field",
          "revision"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          }
        }
      }
    },
    "query_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes_used": {
      "type": "integer",
      "minimum": 0
    },
    "capability_evidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verification",
            "capabilities",
            "scope",
            "limitation"
          ],
          "properties": {
            "verification": {
              "const": "verified"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*?\\[\\]]+$"
              }
            },
            "limitation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "enforcement_claim": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "integrator": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "complete",
        "missing"
      ],
      "properties": {
        "mode": {
          "enum": [
            "explicit_read_set",
            "authorized_owner_queries_and_explicit_read_set"
          ]
        },
        "complete": {
          "const": false
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "target"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "selected_text_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "owner",
        "root",
        "lineage",
        "owned_scopes",
        "capabilities",
        "denied_capabilities",
        "publication",
        "denied_publication",
        "approved_imports",
        "boundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "owned_scopes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read",
            "write",
            "deny_read",
            "deny_write"
          ],
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "deny_read": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "deny_write": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "denied_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "publication": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "denied_publication": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "approved_imports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_context",
              "selector",
              "use",
              "classification",
              "expires"
            ],
            "properties": {
              "from_context": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "use": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "type": "string",
                "minLength": 1
              },
              "expires": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "query_selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "query_id",
          "revision",
          "members",
          "members_digest",
          "selected_digest",
          "coverage",
          "enumerated",
          "policy_revision",
          "authority_digest",
          "excluded_anchor"
        ],
        "properties": {
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "query",
              "reason",
              "use",
              "classification"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "use": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "filters",
                  "max_enumerated",
                  "max_matches",
                  "max_scan_bytes"
                ],
                "properties": {
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "filters": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 8,
                    "propertyNames": {
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": [
                            "string",
                            "integer",
                            "boolean"
                          ]
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 16,
                          "uniqueItems": true,
                          "items": {
                            "type": [
                              "string",
                              "integer",
                              "boolean"
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "max_enumerated": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "max_matches": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 128
                  },
                  "max_scan_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2000000
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "not": {
                  "required": [
                    "section",
                    "field"
                  ]
                }
              }
            }
          },
          "query_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "members": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "page_id"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "page_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "members_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "selected_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "coverage": {
            "const": "complete_only_within_current_authorized_owner_scope"
          },
          "enumerated": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "policy_revision": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "authority_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "excluded_anchor": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
