{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-viva.example/schemas/wiki-upgrade-impact-registry-v1.schema.json",
  "title": "Wiki Viva two-lane impact registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "unknown_policy",
    "gate_catalog",
    "full_matrix_gates",
    "surfaces",
    "boundary_policy",
    "registry_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wiki_viva_upgrade_impact_registry.v1"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "unknown_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contract"
      ],
      "properties": {
        "path": {
          "const": "full_matrix_and_lane_a"
        },
        "contract": {
          "const": "full_matrix_and_lane_a"
        }
      }
    },
    "gate_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "full_matrix_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gateId"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "boundary_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c1_portable_patterns",
        "c2_generated_patterns",
        "c3_consumer_patterns",
        "domain_content_patterns"
      ],
      "properties": {
        "c1_portable_patterns": {
          "$ref": "#/$defs/pathPatterns"
        },
        "c2_generated_patterns": {
          "$ref": "#/$defs/pathPatterns"
        },
        "c3_consumer_patterns": {
          "$ref": "#/$defs/pathPatterns"
        },
        "domain_content_patterns": {
          "$ref": "#/$defs/pathPatterns"
        }
      }
    },
    "registry_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "gateClass": {
      "enum": [
        "upstream_certified",
        "consumer_always",
        "affected",
        "canary",
        "background_certification"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "command"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/gateId"
        },
        "class": {
          "$ref": "#/$defs/gateClass"
        },
        "command": {
          "type": "string",
          "minLength": 3,
          "maxLength": 4096
        }
      }
    },
    "portablePathPattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
    },
    "pathPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/portablePathPattern"
      }
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:+-]{1,127}$"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lane",
        "path_patterns",
        "contracts",
        "gates",
        "depends_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
        },
        "lane": {
          "enum": [
            "lane_a",
            "lane_b"
          ]
        },
        "path_patterns": {
          "$ref": "#/$defs/pathPatterns"
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contractId"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gateId"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
          }
        }
      }
    }
  }
}
