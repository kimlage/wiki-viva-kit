{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-viva.example/schemas/wiki-upgrade-package-v3.schema.json",
  "title": "Wiki Viva two-lane upgrade package v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "contract_versions",
    "portable_import",
    "preflight",
    "migration",
    "runtime_policy",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": "wiki_viva_upgrade_package.v3"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "historical_release_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_sha",
          "status",
          "note"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/releaseId"
          },
          "source_sha": {
            "$ref": "#/$defs/sha"
          },
          "status": {
            "$ref": "#/$defs/nonempty"
          },
          "note": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "contract_versions": {
      "$ref": "#/$defs/contractVersions"
    },
    "portable_import": {
      "$ref": "#/$defs/portableImport"
    },
    "preflight": {
      "$ref": "#/$defs/preflight"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    },
    "runtime_policy": {
      "$ref": "#/$defs/runtimePolicy"
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/compatibilityEntry"
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_public_report",
        "never_publish"
      ],
      "properties": {
        "default_public_report": {
          "$ref": "#/$defs/nonempty"
        },
        "never_publish": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policyId"
          }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "gateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "policyId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!~)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
    },
    "pathPattern": {
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "not": {
            "enum": [
              "*",
              "**",
              "**/*"
            ]
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "source_sha",
        "plan"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/releaseId"
        },
        "status": {
          "$ref": "#/$defs/nonempty"
        },
        "source_sha": {
          "$ref": "#/$defs/sha"
        },
        "plan": {
          "$ref": "#/$defs/path"
        },
        "pull_request": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "contractVersions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nonempty"
      },
      "required": [
        "route",
        "snapshot",
        "snapshot_envelope",
        "blocks",
        "visual_grammar",
        "semantic_visual_tokens",
        "appearance",
        "runtime",
        "source_lifecycle",
        "freshness",
        "server",
        "activity_timeline",
        "temporal_event",
        "temporal_graph",
        "experience_pack",
        "experience_pack_registry",
        "experience_pack_lock",
        "experience_pack_composition",
        "asset_manifest",
        "downstream_adapter_manifest"
      ]
    },
    "portableImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "block"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathPattern"
          }
        },
        "block": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathPattern"
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_prefix",
        "required_gates",
        "gate_mapping"
      ],
      "properties": {
        "branch_prefix": {
          "type": "string",
          "pattern": "^wiki/$"
        },
        "required_gates": {
          "$ref": "#/$defs/gateIds"
        },
        "gate_mapping": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/gateId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/gateId"
          }
        },
        "reviewable_gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "semantic_inventory": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required_boundary",
                "max_findings"
              ],
              "properties": {
                "required_boundary": {
                  "const": "downstream_adaptations"
                },
                "max_findings": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              }
            }
          }
        }
      }
    },
    "gateIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gateId"
      }
    },
    "gateCommands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/gateId"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 3,
        "maxLength": 4096,
        "not": {
          "pattern": "(?i)(?:^\\s*(?:true|:|exit\\s+0)\\s*$|\\b(?:todo|tbd|placeholder|manual|fabricated)\\b)"
        }
      }
    },
    "commandRegistry": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/gateId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "cwd",
          "timeout_seconds",
          "env_allowlist"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000\\r\\n]+$"
            }
          },
          "cwd": {
            "$ref": "#/$defs/path"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "env_allowlist": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            }
          }
        }
      }
    },
    "gateClass": {
      "enum": [
        "upstream_certified",
        "consumer_always",
        "affected",
        "canary",
        "background_certification"
      ]
    },
    "gatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "command_id",
        "asserts",
        "reuse",
        "depends_on",
        "resource_group",
        "required_for_promotion"
      ],
      "properties": {
        "class": {
          "$ref": "#/$defs/gateClass"
        },
        "command_id": {
          "$ref": "#/$defs/gateId"
        },
        "asserts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policyId"
          }
        },
        "reuse": {
          "enum": [
            "exact_capsule",
            "impact",
            "never"
          ]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gateId"
          }
        },
        "resource_group": {
          "$ref": "#/$defs/policyId"
        },
        "required_for_promotion": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "upstream_certified"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "properties": {
              "reuse": {
                "const": "exact_capsule"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "consumer_always"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "properties": {
              "reuse": {
                "const": "never"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "affected"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "properties": {
              "reuse": {
                "const": "impact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "enum": [
                  "canary",
                  "background_certification"
                ]
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "properties": {
              "reuse": {
                "const": "never"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asserts": {
                "contains": {
                  "enum": [
                    "secret_private_audit",
                    "public_evidence_redaction",
                    "input_stage",
                    "operational_pass_current",
                    "semantic_inventory",
                    "adapter_identity",
                    "snapshot_contract",
                    "canary_real",
                    "diff_verification",
                    "rollback_report_verification"
                  ]
                }
              }
            },
            "required": [
              "asserts"
            ]
          },
          "then": {
            "properties": {
              "class": {
                "not": {
                  "const": "upstream_certified"
                }
              },
              "reuse": {
                "const": "never"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asserts": {
                "contains": {
                  "const": "canary_real"
                }
              }
            },
            "required": [
              "asserts"
            ]
          },
          "then": {
            "properties": {
              "class": {
                "const": "canary"
              }
            }
          }
        }
      ]
    },
    "gatePolicies": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/gateId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/gatePolicy"
      }
    },
    "impactRegistryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "wiki_viva_upgrade_impact_registry.v1"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "boundaryGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "owns_patterns"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/policyId"
        },
        "command": {
          "type": "string",
          "minLength": 3,
          "maxLength": 4096,
          "not": {
            "pattern": "(?i)(?:^\\s*(?:true|:|exit\\s+0)\\s*$|\\b(?:todo|tbd|placeholder|manual|fabricated)\\b)"
          }
        },
        "owns_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathPattern"
          }
        }
      }
    },
    "boundaryOperations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "c2_generators",
        "c3_adapter",
        "registry_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "wiki_viva_upgrade_boundary_operations.v1"
        },
        "c2_generators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/boundaryGenerator"
          }
        },
        "c3_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "contract",
            "owns_patterns"
          ],
          "properties": {
            "mode": {
              "const": "consumer_plan_commands"
            },
            "contract": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:+-]{1,127}$"
            },
            "owns_patterns": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/pathPattern"
              }
            }
          }
        },
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "acceptanceBudgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scope",
        "limit_seconds",
        "enforcement"
      ],
      "properties": {
        "schema_version": {
          "const": "wiki_viva_upgrade_acceptance_budget_policy.v1"
        },
        "scope": {
          "const": "plan_to_real_canary"
        },
        "limit_seconds": {
          "const": 1200
        },
        "enforcement": {
          "const": "promotion_blocking"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_boundaries",
        "generated_artifact_patterns",
        "required_gates",
        "gate_commands",
        "command_registry_sha256",
        "impact_registry",
        "gate_policies",
        "acceptance_budget",
        "boundary_operations",
        "visual_profiles"
      ],
      "properties": {
        "commit_boundaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "faithful_public_import"
            },
            {
              "const": "regenerated_artifacts"
            },
            {
              "const": "downstream_adaptations"
            }
          ],
          "items": false
        },
        "generated_artifact_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathPattern"
          }
        },
        "required_gates": {
          "$ref": "#/$defs/gateIds"
        },
        "gate_commands": {
          "$ref": "#/$defs/gateCommands"
        },
        "command_registry": {
          "$ref": "#/$defs/commandRegistry"
        },
        "command_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "impact_registry": {
          "$ref": "#/$defs/impactRegistryReference"
        },
        "gate_policies": {
          "$ref": "#/$defs/gatePolicies"
        },
        "acceptance_budget": {
          "$ref": "#/$defs/acceptanceBudgetPolicy"
        },
        "boundary_operations": {
          "$ref": "#/$defs/boundaryOperations"
        },
        "visual_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          }
        }
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollout_modes",
        "initial_downstream_mode",
        "rollback_first",
        "rollback_second",
        "flags_must_not_weaken"
      ],
      "properties": {
        "rollout_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "legacy",
              "compat",
              "v8"
            ]
          }
        },
        "initial_downstream_mode": {
          "enum": [
            "legacy",
            "compat",
            "v8"
          ]
        },
        "rollback_first": {
          "$ref": "#/$defs/policyId"
        },
        "rollback_second": {
          "$ref": "#/$defs/policyId"
        },
        "flags_must_not_weaken": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policyId"
          }
        }
      }
    },
    "compatibilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "v8_behavior",
        "warning_becomes_error",
        "removal_target"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/policyId"
        },
        "v8_behavior": {
          "$ref": "#/$defs/nonempty"
        },
        "warning_becomes_error": {
          "$ref": "#/$defs/nonempty"
        },
        "removal_target": {
          "$ref": "#/$defs/nonempty"
        }
      }
    }
  }
}
