{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only integration preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "context_id",
    "base",
    "head",
    "branch",
    "task_id",
    "packet_digest",
    "changes",
    "review",
    "gates",
    "merge"
  ],
  "properties": {
    "coverage_missing": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "schema_version": {
      "const": "wiki.context-integration/v1"
    },
    "state": {
      "const": "independent_review_required"
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "created",
              "modified",
              "deleted"
            ]
          }
        }
      }
    },
    "review": {
      "const": "not_performed"
    },
    "gates": {
      "const": "not_performed"
    },
    "merge": {
      "const": "not_performed"
    }
  }
}
