{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed requirements from reported reads",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "output_path",
    "approved_revision",
    "proposal_head",
    "task_id",
    "packet_digest",
    "information_requirements",
    "read_claim",
    "write",
    "self_input_read"
  ],
  "properties": {
    "coverage_missing": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "schema_version": {
      "const": "wiki.context-requirements/v1"
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "approved_revision": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "proposal_head": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "information_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "fields",
          "temporal",
          "max_age_days",
          "consumed_revision",
          "use",
          "classification"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "temporal": {
            "enum": [
              "current",
              "historical"
            ]
          },
          "max_age_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3650
          },
          "consumed_revision": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "use": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "filters",
              "max_enumerated",
              "max_matches",
              "max_scan_bytes"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "filters": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 8,
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": [
                        "string",
                        "integer",
                        "boolean"
                      ]
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 16,
                      "uniqueItems": true,
                      "items": {
                        "type": [
                          "string",
                          "integer",
                          "boolean"
                        ]
                      }
                    }
                  ]
                }
              },
              "max_enumerated": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "max_matches": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "max_scan_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000000
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              }
            },
            "not": {
              "required": [
                "section",
                "field"
              ]
            }
          },
          "members_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "selected_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "query_policy_revision": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "authority_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "authority_format": {"const": "folder"},
          "entry_folder": {"type": "string", "minLength": 1},
          "entry_index": {"type": "string", "minLength": 1},
          "source_kind": {
            "const": "mandatory"
          }
        },
        "dependentRequired": {
          "authority_format": ["entry_folder", "entry_index"],
          "entry_folder": ["authority_format", "entry_index"],
          "entry_index": ["authority_format", "entry_folder"],
          "query": [
            "members_digest",
            "selected_digest",
            "query_policy_revision",
            "authority_digest"
          ],
          "members_digest": [
            "query",
            "selected_digest",
            "query_policy_revision",
            "authority_digest"
          ],
          "selected_digest": [
            "query",
            "members_digest",
            "query_policy_revision",
            "authority_digest"
          ],
          "query_policy_revision": [
            "query",
            "members_digest",
            "selected_digest",
            "authority_digest"
          ],
          "authority_digest": [
            "query",
            "members_digest",
            "selected_digest",
            "query_policy_revision"
          ]
        },
        "allOf": [
          {"if": {"required": ["authority_format"]}, "then": {"anyOf": [{"required": ["query"]}, {"required": ["source_kind"]}]}},
          {
            "if": {
              "required": [
                "source_kind"
              ]
            },
            "then": {
              "properties": {
                "use": {
                  "const": "normative"
                },
                "temporal": {
                  "const": "current"
                },
                "fields": {
                  "const": [
                    "*"
                  ]
                }
              },
              "not": {
                "required": [
                  "query"
                ]
              }
            }
          }
        ]
      }
    },
    "read_claim": {
      "const": "reported_not_verified"
    },
    "write": {
      "const": "not_performed"
    },
    "self_input_read": {
      "type": "boolean"
    }
  }
}
