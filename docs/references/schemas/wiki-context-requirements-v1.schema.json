{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed requirements from reported reads",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "output_path",
    "approved_revision",
    "proposal_head",
    "task_id",
    "packet_digest",
    "information_requirements",
    "read_claim",
    "write",
    "self_input_read"
  ],
  "properties": {
    "schema_version": {
      "const": "wiki.context-requirements/v1"
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "approved_revision": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "proposal_head": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "information_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "fields",
          "temporal",
          "max_age_days",
          "consumed_revision",
          "use",
          "classification"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "temporal": {
            "enum": [
              "current",
              "historical"
            ]
          },
          "max_age_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3650
          },
          "consumed_revision": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "use": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "read_claim": {
      "const": "reported_not_verified"
    },
    "write": {
      "const": "not_performed"
    },
    "self_input_read": {
      "type": "boolean"
    }
  }
}
