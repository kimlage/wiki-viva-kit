{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only multi-owner integration preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "state", "base", "head", "branch", "participants",
    "changes_count", "diff_sha256", "actor_identity", "semantic_coherence",
    "review", "gates", "merge"
  ],
  "properties": {
    "schema_version": {"const": "wiki.context-integration-composite/v1"},
    "state": {"const": "independent_review_required"},
    "base": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "head": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "branch": {"type": "string", "minLength": 1},
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context_id", "task_id", "packet_digest", "changes_count", "coverage_missing_count"],
        "properties": {
          "context_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "packet_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "changes_count": {"type": "integer", "minimum": 1, "maximum": 4096},
          "coverage_missing_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "changes_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "diff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actor_identity": {"const": "not_verified"},
    "semantic_coherence": {"const": "not_assessed"},
    "review": {"const": "not_performed"},
    "gates": {"const": "not_performed"},
    "merge": {"const": "not_performed"}
  }
}
