{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-viva.invalid/schemas/wiki-experience-pack-lock-v1.schema.json",
  "title": "Wiki Viva experience pack lock v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "core_version", "packs"],
  "properties": {
    "schema_version": {"const": "wiki_experience_pack_lock.v1"},
    "core_version": {"const": "8.0.0"},
    "packs": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "status", "manifest_sha256", "tree_sha256", "registry_path", "installed_path", "capabilities", "slots", "dependencies", "conflicts", "files", "receipts"],
        "properties": {
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "status": {"enum": ["active", "disabled"]},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "registry_path": {"type": "string", "minLength": 1},
          "installed_path": {"type": "string", "minLength": 1},
          "capabilities": {"type": "object"}, "slots": {"type": "object"},
          "dependencies": {"type": "array"}, "conflicts": {"type": "array"},
          "files": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"],
              "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}
            }
          },
          "receipts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
