{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-viva.example/schemas/wiki-upgrade-release-capsule-v1.schema.json",
  "title": "Wiki Viva immutable Lane A release capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "status",
    "source_sha",
    "package_sha256",
    "portable_tree_sha256",
    "portable_tree_entry_count",
    "command_registry",
    "command_registry_sha256",
    "toolchain",
    "toolchain_sha256",
    "toolchain_probe_ref",
    "toolchain_probe_sha256",
    "toolchain_probe_entry_count",
    "certified_gates",
    "gate_receipt_sha256",
    "run_id",
    "visual_manifest_ref",
    "visual_manifest_sha256",
    "visual_manifest_entry_count",
    "attestation_authority_id",
    "attestation_ref",
    "attestation_sha256",
    "capsule_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wiki_viva_upgrade_release_capsule.v1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "status": {
      "const": "certified"
    },
    "source_sha": {
      "$ref": "#/$defs/sha"
    },
    "package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "portable_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "portable_tree_entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "command_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "command_registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "node",
        "browser",
        "runner"
      ],
      "properties": {
        "python": {
          "$ref": "#/$defs/toolIdentity"
        },
        "node": {
          "$ref": "#/$defs/toolIdentity"
        },
        "browser": {
          "$ref": "#/$defs/toolIdentity"
        },
        "runner": {
          "$ref": "#/$defs/toolIdentity"
        }
      }
    },
    "toolchain_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain_probe_ref": {
      "$ref": "#/$defs/path"
    },
    "toolchain_probe_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain_probe_entry_count": {
      "const": 4
    },
    "certified_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/certifiedGate"
      }
    },
    "gate_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_id": {
      "$ref": "#/$defs/gateId"
    },
    "visual_manifest_ref": {
      "$ref": "#/$defs/path"
    },
    "visual_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "visual_manifest_entry_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "attestation_authority_id": {
      "$ref": "#/$defs/gateId"
    },
    "attestation_ref": {
      "$ref": "#/$defs/path"
    },
    "attestation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "capsule_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
    },
    "gateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "gateClass": {
      "enum": [
        "upstream_certified",
        "consumer_always",
        "affected",
        "canary",
        "background_certification"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "command"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/gateId"
        },
        "class": {
          "$ref": "#/$defs/gateClass"
        },
        "command": {
          "type": "string",
          "minLength": 3,
          "maxLength": 4096
        }
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        }
      }
    },
    "certifiedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "provenance",
        "status",
        "exit_code",
        "subject_sha",
        "command_sha256",
        "output_ref",
        "output_sha256",
        "output_bytes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/gateId"
        },
        "class": {
          "const": "upstream_certified"
        },
        "provenance": {
          "const": "executed"
        },
        "status": {
          "const": "passed"
        },
        "exit_code": {
          "const": 0
        },
        "subject_sha": {
          "$ref": "#/$defs/sha"
        },
        "command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_ref": {
          "$ref": "#/$defs/path"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    }
  }
}
