{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-viva.invalid/schemas/wiki-temporal-event-v1.schema.json",
  "title": "Wiki Viva canonical temporal event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "kind",
    "subject_refs",
    "context_refs",
    "occurred_at",
    "recorded_at",
    "valid_from",
    "valid_to",
    "created_at",
    "due_at",
    "completed_at",
    "verified_at",
    "ingested_at",
    "superseded_at",
    "precision",
    "actor",
    "source_refs",
    "evidence_refs",
    "caused_by",
    "supersedes",
    "before",
    "after",
    "confidence",
    "visibility",
    "origin",
    "temporal_conflicts",
    "anchor"
  ],
  "properties": {
    "schema_version": {"const": "wiki_temporal_event.v1"},
    "event_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,159}$"
    },
    "kind": {
      "oneOf": [
        {"enum": [
        "activity_recorded",
        "snapshot_recorded",
        "git_commit_recorded",
        "page_updated",
        "source_configured",
        "source_ingested",
        "source_refreshed",
        "source_refresh_due",
        "source_pipeline_advanced",
        "ingestion_recorded",
        "action_created",
        "action_due",
        "action_completed",
        "action_cancelled",
        "action_state_changed",
        "action_state_canonicalized",
        "action_contract_updated",
        "decision_recorded",
        "decision_made",
        "receipt_recorded"
        ]},
        {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){1,5}$", "maxLength": 80}
      ]
    },
    "lane": {"enum": ["source", "action", "decision", "receipt", "page", "system", "other"]},
    "subject_refs": {"$ref": "#/$defs/non_empty_refs"},
    "context_refs": {"$ref": "#/$defs/non_empty_refs"},
    "occurred_at": {"$ref": "#/$defs/nullable_temporal_value"},
    "recorded_at": {"$ref": "#/$defs/nullable_temporal_value"},
    "valid_from": {"$ref": "#/$defs/nullable_temporal_value"},
    "valid_to": {"$ref": "#/$defs/nullable_temporal_value"},
    "created_at": {"$ref": "#/$defs/nullable_temporal_value"},
    "due_at": {"$ref": "#/$defs/nullable_temporal_value"},
    "completed_at": {"$ref": "#/$defs/nullable_temporal_value"},
    "verified_at": {"$ref": "#/$defs/nullable_temporal_value"},
    "ingested_at": {"$ref": "#/$defs/nullable_temporal_value"},
    "superseded_at": {"$ref": "#/$defs/nullable_temporal_value"},
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occurred_at": {"$ref": "#/$defs/precision"},
        "recorded_at": {"$ref": "#/$defs/precision"},
        "valid_from": {"$ref": "#/$defs/precision"},
        "valid_to": {"$ref": "#/$defs/precision"},
        "created_at": {"$ref": "#/$defs/precision"},
        "due_at": {"$ref": "#/$defs/precision"},
        "completed_at": {"$ref": "#/$defs/precision"},
        "verified_at": {"$ref": "#/$defs/precision"},
        "ingested_at": {"$ref": "#/$defs/precision"},
        "superseded_at": {"$ref": "#/$defs/precision"}
      }
    },
    "actor": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref"],
          "properties": {
            "kind": {"enum": ["human", "agent", "system", "unknown"]},
            "ref": {"$ref": "#/$defs/ref"}
          }
        }
      ]
    },
    "source_refs": {"$ref": "#/$defs/refs"},
    "evidence_refs": {"$ref": "#/$defs/refs"},
    "caused_by": {"$ref": "#/$defs/refs"},
    "supersedes": {"$ref": "#/$defs/refs"},
    "before": {"type": "object", "maxProperties": 128},
    "after": {"type": "object", "maxProperties": 128},
    "confidence": {
      "enum": ["confirmed", "inferred", "uncertain", "conflicting"]
    },
    "visibility": {"enum": ["public", "private"]},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1, "maxLength": 120},
        "legacy_kind": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "temporal_conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "valid_to_before_valid_from",
          "due_at_before_created_at",
          "completed_at_before_created_at",
          "superseded_at_before_valid_from"
        ]
      }
    },
    "anchor": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "value", "precision"],
          "properties": {
            "field": {
              "enum": [
                "occurred_at",
                "recorded_at",
                "valid_from",
                "valid_to",
                "created_at",
                "due_at",
                "completed_at",
                "verified_at",
                "ingested_at",
                "superseded_at"
              ]
            },
            "value": {"$ref": "#/$defs/temporal_value"},
            "precision": {"$ref": "#/$defs/precision"}
          }
        }
      ]
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}:[A-Za-z0-9][A-Za-z0-9._/:-]{0,255}$"
    },
    "refs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "non_empty_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "precision": {"enum": ["year", "month", "day", "instant"]},
    "temporal_value": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9]{4}$"},
        {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
        {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[0-1])$"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[0-1])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "format": "date-time"
        }
      ]
    },
    "nullable_temporal_value": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/temporal_value"}
      ]
    }
  }
}
